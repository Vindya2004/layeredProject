      <Button fx:id="btnEmpDelete" layoutX="901.0" layoutY="799.0" mnemonicParsing="false" onAction="#deleteOnAction" prefHeight="48.0" prefWidth="196.0" style="-fx-background-color: #75bfcd;" text="Delete" textFill="#111010">
