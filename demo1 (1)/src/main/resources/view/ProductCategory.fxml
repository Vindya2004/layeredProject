<AnchorPane prefHeight="900.0" prefWidth="1156.0" style="-fx-background-color: ffd6a3;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.sweetdelightfx.demo1.controller.ProductCategoryController">
