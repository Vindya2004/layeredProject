<AnchorPane fx:id="ancLogin" prefHeight="1040.0" prefWidth="1900.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.sweetdelightfx.demo1.controller.LoginController">
